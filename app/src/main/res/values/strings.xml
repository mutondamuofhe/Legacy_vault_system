    <string name="help_title">Help &amp; User Support</string>
    <string name="help_subtitle">Learn how to manage your digital legacy and get assistance</string>
    <string name="user_guide_section">User Guide &amp; Documentation</string>
    <string name="user_guide_content">Welcome to Legacy Vault System! This application allows you to securely store and organize your digital legacy for your designated executors.\n\n1. Digital Assets: Record your digital accounts, credentials, and specify post-mortem actions.\n2. Document Vault: Upload and organize essential identity, legal, and financial documents.\n3. Executors: Assign trusted contacts and assign them tailored access levels.\n4. Instructions: Write specific directives for your executors regarding handling your digital footprint.</string>
    <string name="faq_section">Frequently Asked Questions (FAQ)</string>
    <string name="faq1_q">Q: Is my data securely stored?</string>
    <string name="faq1_a">A: Yes, all data is authenticated and stored securely in Cloud Firestore with encrypted credentials.</string>
    <string name="faq2_q">Q: How do my executors access my vault?</string>
    <string name="faq2_a">A: Assigned executors receive permission based on their access level after submitting an access request to the administrator.</string>
    <string name="faq3_q">Q: Can I change or revoke an executor?</string>
    <string name="faq3_a">A: Yes, you can add, edit, or remove executors anytime from the Executors tab.</string>
